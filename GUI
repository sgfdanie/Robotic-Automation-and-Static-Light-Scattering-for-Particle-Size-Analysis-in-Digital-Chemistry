# ---------------------------------------------------------------------------
# Overall callback
# ---------------------------------------------------------------------------
# Main callback for handling all user control actions.
# Depending on which button triggered the callback, this function:
# - Starts selected pumps
# - Stops an individual pump
# - Stops all pumps
# - Updates the status message
@app.callback(

    Output("status-message", "children"),

    Input("start-button", "n_clicks"),
    Input("stopA", "n_clicks"),
    Input("stopB", "n_clicks"),
    Input("stopC", "n_clicks"),
    Input("stopD", "n_clicks"),
    Input("stopAll", "n_clicks"),

    State("pumpA", "value"),
    State("volumeA", "value"),
    State("directionA", "value"),

    State("pumpB", "value"),
    State("volumeB", "value"),
    State("directionB", "value"),

    State("pumpC", "value"),
    State("volumeC", "value"),
    State("directionC", "value"),

    State("pumpD", "value"),
    State("volumeD", "value"),
    State("directionD", "value"),

    State("dropwise", "value"),

    prevent_initial_call=True

)

def control_callback(

    clicks_start,
    clicks_stopA,
    clicks_stopB,
    clicks_stopC,
    clicks_stopD,
    clicks_stopAll,

    pumpA, volumeA, directionA,
    pumpB, volumeB, directionB,
    pumpC, volumeC, directionC,
    pumpD, volumeD, directionD,

    dropwise

):

    button = ctx.triggered_id


    # Dispensing-------------------------------

    if button == "start-button":

        started = []

        if pumpA and volumeA is not None:
            command = "RA" if directionA == "reverse" else "A"

            if "ON" in dropwise:

                threading.Thread(
                    target=start_pump_dropwise,
                    args=(command, volumeA),
                    daemon=True
                ).start()

            else:
                start_pump(command, volumeA)

            started.append("Pump A")


        if pumpB and volumeB is not None:

            command = "RB" if directionB == "reverse" else "B"

            if "ON" in dropwise:

                threading.Thread(
                    target=start_pump_dropwise,
                    args=(command, volumeB),
                    daemon=True
                ).start()

            else:
                start_pump(command, volumeB)

            started.append("Pump B")


        if pumpC and volumeC is not None:

            command = "RC" if directionC == "reverse" else "C"

            if "ON" in dropwise:

                threading.Thread(
                    target=start_pump_dropwise,
                    args=(command, volumeC),
                    daemon=True
                ).start()

            else:
                start_pump(command, volumeC)

            started.append("Pump C")


        if pumpD and volumeD is not None:

            command = "RD" if directionD == "reverse" else "D"

            if "ON" in dropwise:

                threading.Thread(
                    target=start_pump_dropwise,
                    args=(command, volumeD),
                    daemon=True
                ).start()

            else:
                start_pump(command, volumeD)

            started.append("Pump D")


        if len(started) == 0:

            return "No pumps selected."

        return "Started: " + ", ".join(started)


    # Stop button --------------------------------

    elif button == "stopA":
        stop_pump("A")
        return "Pump A stopped."


    elif button == "stopB":
        stop_pump("B")
        return "Pump B stopped."


    elif button == "stopC":
        stop_pump("C")
        return "Pump C stopped."


    elif button == "stopD":
        stop_pump("D")
        return "Pump D stopped."


    elif button == "stopAll":
        stop_all_pumps()
        return "All pumps stopped."

    return "Ready"


# ---------------------------------------------------------------------------
# Live Volume Display Callback
# ---------------------------------------------------------------------------
@app.callback(

    Output("overall-total","children"),
    Output("pump-totals","children"),
    Input("refresh","n_intervals")
)

def update_volume_display(n):

    # Load the latest JSON log
    data = load_JSON_log()

    # Get total transferred volume
    total = data["total_volume_dispensed"]

    # Get individual pump totals
    pump_data = data["totals"]

    total_text = (
        f"Total Volume Dispensed: "
        f"{round(total,2)} mL"
    )

    pump_text = (
        f"""
        Pump A: {round(pump_data["A"],2)} mL
        Pump B: {round(pump_data["B"],2)} mL
        Pump C: {round(pump_data["C"],2)} mL
        Pump D: {round(pump_data["D"],2)} mL
        """
    )

    return total_text, pump_text

